{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:setup": "tsx src/db-cli.ts",
    "db:migrate": "tsx src/migrate-cli.ts",
    "db:cleanup-test-data": "tsx src/db-cleanup-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:mysql": "node ../../scripts/test-mysql.mjs",
    "lint": "eslint src --max-warnings=0",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@crm/contracts": "*",
    "@fastify/cors": "latest",
    "@fastify/jwt": "latest",
    "bcryptjs": "latest",
    "dotenv": "latest",
    "exceljs": "^4.4.0",
    "fastify": "latest",
    "mysql2": "^3.15.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
