NODE_ENV=development
API_PORT=3333
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3333
JWT_SECRET=replace-with-at-least-32-random-characters
STORAGE_MODE=memory
# Proxies confiáveis à frente da API para ler o IP real do cliente (X-Forwarded-For).
# 1 atrás de um proxy (Vercel, Hostinger); 0 (padrão) ignora o cabeçalho.
TRUST_PROXY=0
SEED_DEMO_DATA=true
# MySQL 8 ou MariaDB 10.6+ (ex.: o banco da Hostinger). STORAGE_MODE=mysql para usá-lo.
DATABASE_URL=mysql://crm:crm@localhost:3306/crm
# TLS do banco: disable (padrão; banco no mesmo servidor), require (criptografa sem verificar a CA)
# ou verify (exige DATABASE_SSL_CA com o certificado da CA).
DATABASE_SSL=disable
DATABASE_SSL_CA=
# Servidor dos testes de integração: cada arquivo cria e apaga um banco <nome>_<teste>_<id>,
# então o usuário precisa poder criar bancos com esse prefixo. Nunca produção.
TEST_DATABASE_URL=
REDIS_URL=redis://localhost:6379
 