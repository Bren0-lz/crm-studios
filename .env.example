NODE_ENV=development
API_PORT=3333
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3333
JWT_SECRET=replace-with-at-least-32-random-characters
STORAGE_MODE=memory
# Proxies confiáveis à frente da API para ler o IP real do cliente (X-Forwarded-For).
# 1 na Vercel; 0 (padrão) ignora o cabeçalho.
TRUST_PROXY=0
SEED_DEMO_DATA=true
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# TLS do banco: auto (liga em hosts do Supabase), disable, require (criptografa sem verificar a CA)
# ou verify (exige DATABASE_SSL_CA com o certificado da CA, baixado no painel do Supabase).
DATABASE_SSL=auto
DATABASE_SSL_CA=
# Banco exclusivo para os testes de integração (cria e apaga registros próprios). Nunca produção.
TEST_DATABASE_URL=
CRM_POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
 